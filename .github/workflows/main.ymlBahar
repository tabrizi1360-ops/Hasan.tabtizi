name: Build Android APK
on:
  workflow_dispatch:
  push:
    branches: [ main ]

jobs:
  build:
    runs-on: ubuntu-latest
    env:
      ANDROID_SDK_ROOT: /opt/android/sdk
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Java 17
        uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: '17'

      - name: Install basic deps
        run: |
          sudo apt-get update -y
          sudo apt-get install -y build-essential git wget unzip zip \
            libncurses5 libstdc++6 libssl-dev libffi-dev python3 python3-pip python3-setuptools python3-wheel

      - name: Install Android command line tools
        run: |
          sudo mkdir -p /opt/android
          sudo chown $USER /opt/android
          wget https://dl.google.com/android/repository/commandlinetools-linux-9477386_latest.zip -O /tmp/cmdline.zip
          unzip -qq /tmp/cmdline.zip -d /tmp/cmdline
          mkdir -p /opt/android/cmdline-tools/latest
          mv /tmp/cmdline/cmdline-tools/* /opt/android/cmdline-tools/latest/

      - name: Set Android env
        run: |
          echo "ANDROID_SDK_ROOT=/opt/android" >> $GITHUB_ENV
          echo "PATH=/opt/android/cmdline-tools/latest/bin:/opt/android/platform-tools:$PATH" >> $GITHUB_ENV

      - name: Install SDK packages
        run: |
          yes | /opt/android/cmdline-tools/latest/bin/sdkmanager --sdk_root=/opt/android "platform-tools" "platforms;android-31" "build-tools;31.0.0" "ndk;23.1.7779620"

      - name: Accept licenses
        run: |
          yes | /opt/android/cmdline-tools/latest/bin/sdkmanager --licenses --sdk_root=/opt/android || true

      - name: Install Buildozer
        run: |
          python3 -m pip install --upgrade pip
          pip install buildozer cython virtualenv

      - name: Build APK
        working-directory: build
        run: buildozer -v android debug

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: jewelry-app-apk
          path: build/bin/*.apk
